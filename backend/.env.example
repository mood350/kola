# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Random HMAC key for signing JWTs. Generate with:
#   openssl rand -base64 64
JWT_SECRET_KEY=

# Gmail app password (myaccount.google.com/apppasswords), or your SMTP provider's creds.
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional overrides (defaults match local Postgres/MailHog setup):
# DB_URL=jdbc:postgresql://localhost:5432/kola_db
# DB_USERNAME=root
# DB_PASSWORD=root
# MAIL_HOST=localhost
# MAIL_PORT=1025

# Page d'activation vers laquelle pointe l'email de confirmation.
# Defaut : http://localhost:3002/confirmation (frontend-web en local).
# FRONTEND_ACTIVATION_URL=https://app.kola.tg/confirmation

# --- FedaPay (encaissement Mobile Money) ---
# Cles du tableau de bord FedaPay, onglet API. sk_sandbox_... en bac a sable.
# Sans FEDAPAY_ENABLED=true, l'integration reste inerte.
# FEDAPAY_ENABLED=true
# FEDAPAY_API_KEY=sk_sandbox_xxxxxxxxxxxxxxxx
# Secret de l'endpoint webhook (Workbench -> Webhooks -> Click to reveal).
# Il signe les notifications : sans lui, aucune n'est acceptee.
# FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxx
# Production : https://api.fedapay.com/v1 — a ne changer qu'en connaissance de cause.
# FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com/v1
# FEDAPAY_CALLBACK_URL=http://localhost:3002/transactions
# Prelevement direct : la demande de debit part sur le telephone du client.
# C'est une AUTORISATION COMMERCIALE accordee par FedaPay compte par compte ;
# sans elle, tous les operateurs repondent 400 « Operation non autorisee ».
# Laisse a false, le repli est la page de paiement hebergee, qui fonctionne
# sans autorisation particuliere et aboutit au meme webhook.
# A passer a true seulement apres confirmation de FedaPay.
# FEDAPAY_DIRECT_CHARGE=false
# Retraits (versements sortants). Autorisation distincte de l'encaissement :
# sans elle, POST /v1/payouts repond 403 quelle que soit la cle. Et contrairement
# au depot, IL N'Y A AUCUN REPLI — un versement part du solde marchand, il
# n'existe pas de page ou le client irait se payer lui-meme. Laisse a false, le
# retrait Mobile Money est refuse AVANT tout debit du portefeuille.
# FEDAPAY_PAYOUTS_ENABLED=false
