{
  "expo": {
    "name": "DOGAA",
    "slug": "dogaa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF8FF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002353"
      },
      "permissions": [
        "READ_CONTACTS",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSContactsUsageDescription": "DOGAA utilise vos contacts pour choisir un bénéficiaire.",
        "NSCameraUsageDescription": "DOGAA utilise la caméra pour scanner les QR codes de paiement."
      }
    },
    "plugins": [
      "expo-contacts",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez DOGAA à utiliser la caméra pour scanner les QR codes de paiement.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
