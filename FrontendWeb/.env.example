# Copy this file to .env.local and fill in the real backend URL once it exists.
#
# Unset (or empty): the app runs entirely on in-memory mock data
# (src/repositories/*.js Mock* classes) — no backend needed to develop the UI.
#
# Set: every repository automatically switches to its Http* implementation
# and starts calling the real API (see BACKEND.md for the full contract).
VITE_API_BASE_URL=
