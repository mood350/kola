# ============================================================================
# Kola — console d'administration (frontend-admin/)
#
# Copier en `.env.local` et ajuster si besoin. `.env.local` est ignoré par git.
# ============================================================================

# ----------------------------------------------------------------------------
# Racine de l'API Spring Boot
# ----------------------------------------------------------------------------
# Sans barre oblique finale. Défaut : http://localhost:8081/api
#
# ATTENTION AU CORS. Le backend n'autorise que les origines listées dans
# SecurityConfig.corsConfigurationSource() — aujourd'hui http://localhost:3000
# et http://10.0.2.2:8081. C'est pourquoi cette console est épinglée au port
# 3000 (scripts `dev` et `start`). Pointer cette variable vers un backend
# déployé exige d'ajouter l'origine de la console à cette liste, côté Java.
#
# Le préfixe NEXT_PUBLIC_ est nécessaire : la valeur est lue depuis le
# navigateur. Elle n'a rien de secret — c'est une URL publique.
NEXT_PUBLIC_API_URL=http://localhost:8081/api
